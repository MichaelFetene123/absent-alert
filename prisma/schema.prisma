datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  LATE
}

enum NotificationStatus {
  PENDING
  SENDING
  ACCEPTED
  DELIVERED
  FAILED
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String
  passwordHash String
  role         Role
  classes      TeacherClass[]
  marked       AttendanceRecord[]
}

model Class {
  id       String         @id @default(cuid())
  name     String         @unique
  students Student[]
  teachers TeacherClass[]
}

model TeacherClass {
  userId  String
  classId String
  user    User   @relation(fields: [userId], references: [id])
  class   Class  @relation(fields: [classId], references: [id])

  @@id([userId, classId])
}

model Student {
  id          String             @id @default(cuid())
  admissionNo String             @unique
  fullName    String
  classId     String
  active      Boolean            @default(true)
  class       Class              @relation(fields: [classId], references: [id])
  guardians   Guardian[]
  attendance  AttendanceRecord[]
}

model Guardian {
  id        String  @id @default(cuid())
  studentId String
  name      String
  phone     String  // E.164
  isPrimary Boolean @default(true)
  student   Student @relation(fields: [studentId], references: [id])
}

model AttendanceRecord {
  id            String             @id @default(cuid())
  studentId     String
  date          DateTime           @db.Date
  status        AttendanceStatus
  markedById    String
  updatedAt     DateTime           @updatedAt
  student       Student            @relation(fields: [studentId], references: [id])
  markedBy      User               @relation(fields: [markedById], references: [id])
  notifications Notification[]

  @@unique([studentId, date])
}

model Notification {
  id            String                @id @default(cuid())
  attendanceId  String
  guardianPhone String
  type          String                @default("ABSENCE")
  body          String
  status        NotificationStatus    @default(PENDING)
  providerRef   String?
  createdAt     DateTime              @default(now())
  attendance    AttendanceRecord      @relation(fields: [attendanceId], references: [id])
  attempts      NotificationAttempt[]

  // one absence SMS per attendance record per phone
  @@unique([attendanceId, guardianPhone, type])
}

model NotificationAttempt {
  id             String       @id @default(cuid())
  notificationId String
  attemptedAt    DateTime     @default(now())
  httpStatus     Int?
  success        Boolean
  rawResponse    Json?
  error          String?
  notification   Notification @relation(fields: [notificationId], references: [id])
}
